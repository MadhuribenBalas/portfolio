{
  "name": "madhuriben-portfolio",
  "description": "Personal portfolio of Madhuriben Balas, Senior Tester – Automation",
  "author": "Madhuriben Balas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "test:logos": "playwright test tests/e2e/logos.spec.ts --project=desktop",
    "test:logos:all": "LOGO_STRICT=1 playwright test tests/e2e/logos.spec.ts --project=desktop"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
